<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests of milestone M7 (comparisons). They read the real Data folder and make test plugins with Mutagen
       in a work folder outside Data and outside the repo, so they are a program with the Data folder as its
       argument, like sfsindex-tests and sfsrecord-tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sfscompare-tests</AssemblyName>
    <RootNamespace>SFSearch.Compare.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SFSearch.Compare\SFSearch.Compare.csproj" />
  </ItemGroup>

</Project>
