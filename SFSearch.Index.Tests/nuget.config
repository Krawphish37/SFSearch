<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The fixed Mutagen build SFSearch uses (0.55.0-fixes.17), in the repository's packages\ folder; its source is named in ..\nuget.config. -->
    <add key="sfsearch-local" value="..\packages" />
  </packageSources>
</configuration>
