<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SFSearch.Mcp</AssemblyName>
    <RootNamespace>SFSearch.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- The message format shared with the SFSearch service -->
    <Compile Include="..\SFSearch\Service\Protocol.cs" Link="Protocol.cs" />
  </ItemGroup>

</Project>
