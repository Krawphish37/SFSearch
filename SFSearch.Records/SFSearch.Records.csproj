<Project Sdk="Microsoft.NET.Sdk">

  <!-- Records, cards and evidence: milestone M3 of design\agent-first\PLAN.md (ARCHITECTURE.md section 5).
       A library: plugins held open as Mutagen overlays, every record as Mutagen.Bethesda.Serialization's full-profile
       JSON, the card made from that JSON and schema.db, the raw subrecords, and the one-record verify. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SFSearch.Records</RootNamespace>
    <Version>0.1.0</Version>
    <MutagenVersion>0.55.0-fixes.26</MutagenVersion>
    <SerializationVersion>1.38.6-fixes.7</SerializationVersion>
    <!-- Only for the serializers the source generator writes into this library (files this project can't edit):
         async methods with no await (CS1998), Mutagen members marked obsolete (CS0618), and nullable marks in
         files with no nullable setting (CS8632, CS8669). The hand-written files need none of them. -->
    <NoWarn>$(NoWarn);CS1998;CS0618;CS8632;CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SFSearch.Index\SFSearch.Index.csproj" />
    <ProjectReference Include="..\SFSearch.SchemaGen\SFSearch.SchemaGen.csproj" />
    <PackageReference Include="Mutagen.Bethesda.Core" Version="[$(MutagenVersion)]" />
    <PackageReference Include="Mutagen.Bethesda.Kernel" Version="[$(MutagenVersion)]" />
    <PackageReference Include="Mutagen.Bethesda.Starfield" Version="[$(MutagenVersion)]" />
    <PackageReference Include="Mutagen.Bethesda.Serialization" Version="$(SerializationVersion)" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.Newtonsoft" Version="$(SerializationVersion)" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.SourceGenerator" Version="$(SerializationVersion)" PrivateAssets="all" />
    <!-- schema.db is made by the build of SFSearch.SchemaGen; a copy travels with this library -->
    <None Include="..\SFSearch.SchemaGen\bin\$(Configuration)\net10.0\schema.db" Link="schema.db" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <InternalsVisibleTo Include="sfsrecord-tests" />
    <InternalsVisibleTo Include="sfsrecord" />
  </ItemGroup>

</Project>
