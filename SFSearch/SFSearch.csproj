  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Mutagen.Bethesda.Starfield" Version="0.55.0-fixes.5" />
  </ItemGroup>

</Project>

