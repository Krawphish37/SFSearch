<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The fixed Mutagen build SFSearch needs: Mutagen 0.55.0-fixes.26 and Mutagen.Bethesda.Serialization 1.38.6-fixes.7 (with .Newtonsoft and .SourceGenerator), in packages\. Source: branch fixes26 of https://github.com/Krawphish37/Mutagen and branch fixes/1.38.6-fixes.7 of https://github.com/Krawphish37/Mutagen.Bethesda.Serialization; each package's nuspec names its commit. 1.0.x used 0.55.0-fixes.5 from branch starfield-fixes5. -->
    <add key="sfsearch-local" value="packages" />
  </packageSources>
</configuration>
